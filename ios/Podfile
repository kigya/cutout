# Resolve react_native_pods.rb with node to allow hoisting from the repository root.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

firebase_configured = File.exist?(File.join(__dir__, 'Cutout', 'GoogleService-Info.plist'))
use_frameworks! :linkage => :static if firebase_configured

target 'Cutout' do
  config = use_native_modules!
  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  pod 'onnxruntime-objc', '1.30.0'
  if firebase_configured
    # Firebase 12.17 is the final CocoaPods-compatible line used by this project.
    pod 'FirebaseAnalytics/Core', '12.17.0'
    pod 'FirebaseCrashlytics', '12.17.0'
    pod 'FirebaseRemoteConfig', '12.17.0'
  end

  post_install do |installer|
    react_native_post_install(installer, config[:reactNativePath], :mac_catalyst_enabled => false)
  end
end
